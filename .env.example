# ---- REQUIRED for the app to work ----
# Public by design (shipped to the browser). Safe only because Row Level Security is on.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Needed by /api routes (intake, invites, documents, WhatsApp, cron).
SUPABASE_SERVICE_ROLE_KEY=
# Exact public origin of the deployed app, no trailing path. Used for invite links and Twilio signature checks.
APP_BASE_URL=https://your-app.vercel.app

# ---- OPTIONAL (app degrades gracefully when empty) ----
OPENAI_API_KEY=          # empty: labelled DEMO extractor (simple rules, not AI)
OPENAI_MODEL=gpt-4o
TWILIO_ACCOUNT_SID=      # empty: no WhatsApp image download
TWILIO_AUTH_TOKEN=       # empty: every WhatsApp webhook request is rejected (403)
CRON_SECRET=             # empty: daily reminder route rejects all calls, no reminders are created
SCORE_WEIGHTS=           # optional JSON, e.g. {"mission":0.4}

# ---- LOCAL DEVELOPMENT ONLY ----
WHATSAPP_DEMO=           # 1 skips Twilio signature checks outside production. Ignored when NODE_ENV=production.
